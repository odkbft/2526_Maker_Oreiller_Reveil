/* USER CODE BEGIN 4 */
void DF_PlayTrack(uint16_t track) {
    // Format : Start | Version | Length | Command | Feedback | Para_MSB | Para_LSB | End
    uint8_t buf[8] = {0x7E, 0xFF, 0x06, 0x03, 0x00, (uint8_t)(track >> 8), (uint8_t)(track & 0xFF), 0xEF};
    HAL_UART_Transmit(&huart2, buf, 8, 100);
}

void DF_SetVolume(uint8_t volume) {
    if (volume > 30) volume = 30; // Max 30
    uint8_t buf[8] = {0x7E, 0xFF, 0x06, 0x06, 0x00, 0x00, volume, 0xEF};
    HAL_UART_Transmit(&huart2, buf, 8, 100);
}

void DF_Stop() {
    uint8_t buf[8] = {0x7E, 0xFF, 0x06, 0x16, 0x00, 0x00, 0x00, 0xEF};
    HAL_UART_Transmit(&huart2, buf, 8, 100);
}
