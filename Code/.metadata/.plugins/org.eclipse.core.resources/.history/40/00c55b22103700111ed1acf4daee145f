/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_ADC1_Init();
  MX_TIM16_Init();
  MX_USART1_UART_Init();
  MX_RTC_Init();
  MX_USART2_UART_Init();

  /* USER CODE BEGIN 2 */
    HAL_Delay(500); // Laisse le temps au module de s'allumer
    DF_SetVolume(20);
    /* USER CODE END 2 */

  /* Initialize leds */
  BSP_LED_Init(LED_GREEN);

  /* Initialize COM1 port (115200, 8 bits (7-bit data + 1 stop bit), no parity */
  BspCOMInit.BaudRate   = 115200;
  BspCOMInit.WordLength = COM_WORDLENGTH_8B;
  BspCOMInit.StopBits   = COM_STOPBITS_1;
  BspCOMInit.Parity     = COM_PARITY_NONE;
  BspCOMInit.HwFlowCtl  = COM_HWCONTROL_NONE;
  if (BSP_COM_Init(COM1, &BspCOMInit) != BSP_ERROR_NONE)
  {
    Error_Handler();
  }

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
      // --- 1. RÉCEPTION BLUETOOTH ---
      if (HAL_UART_Receive(&huart1, &byte_recu, 1, 10) == HAL_OK) {

          // REGLER L'HEURE "s+heure format 2424" (ex:s2012)
          if (byte_recu == 's') {
              uint8_t buffer[4];
              if (HAL_UART_Receive(&huart1, buffer, 4, 500) == HAL_OK) {
                  sTime.Hours = (buffer[0] - '0') * 10 + (buffer[1] - '0');
                  sTime.Minutes = (buffer[2] - '0') * 10 + (buffer[3] - '0');
                  sTime.Seconds = 0;
                  HAL_RTC_SetTime(&hrtc, &sTime, RTC_FORMAT_BIN);
                  HAL_UART_Transmit(&huart1, (uint8_t*)"Heure OK!\r\n", 11, 100);
              }
          }

          // REGLER L'ALARME "a+heure format 2424" (ex:a2012)
          else if (byte_recu == 'a') {
              uint8_t buffer[4];
              if (HAL_UART_Receive(&huart1, buffer, 4, 500) == HAL_OK) {
                  al_h = (buffer[0] - '0') * 10 + (buffer[1] - '0');
                  al_m = (buffer[2] - '0') * 10 + (buffer[3] - '0');
                  alarme_activee = 1; // Alarme programmée
                  sprintf(msg, "Alarme reglee: %02d:%02d\r\n", al_h, al_m);
                  HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), 100);
              }
          }

          // STOPPER L'ALARME "x"
          else if (byte_recu == 'x') {
              alarme_activee = 0;
              HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3, GPIO_PIN_RESET);
              DF_Stop();
              HAL_UART_Transmit(&huart1, (uint8_t*)"Alarme stop\r\n", 16, 100);
          }
      }

      // --- 2. LOGIQUE DE L'HORLOGE ET COMPARAISON ---
      if (HAL_GetTick() - timer_envoi > 1000) {
          HAL_RTC_GetTime(&hrtc, &sTime, RTC_FORMAT_BIN);
          HAL_RTC_GetDate(&hrtc, &sDate, RTC_FORMAT_BIN);

          // Affichage sur le téléphone toutes les secondes
          sprintf(msg, "Heure: %02d:%02d:%02d\r\n", sTime.Hours, sTime.Minutes, sTime.Seconds);
          HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), 100);

          // Vérification de l'alarme
          if (alarme_activee == 1 && sTime.Hours == al_h && sTime.Minutes == al_m) {
              alarme_activee = 2;
              HAL_UART_Transmit(&huart1, (uint8_t*)"!!! ALARME !!!\r\n", 16, 100);
              DF_PlayTrack(1);
          }

          timer_envoi = HAL_GetTick();
      }

      // --- 3. GESTION DU VIBREUR ---
      if (alarme_activee == 2) {
          if ((HAL_GetTick() / 500) % 2) {
              HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3, GPIO_PIN_SET);
          } else {
              HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3, GPIO_PIN_RESET);
          }
      }

    /* USER CODE END WHILE */

  }
    /* USER CODE BEGIN 3 */

  /* USER CODE END 3 */
}

